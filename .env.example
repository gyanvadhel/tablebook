# Postgres connection string.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the "Transaction pooler" URI (port 6543) when deploying to serverless.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Signs the admin session token for the Next.js app. Use a long random string.
# REQUIRED IN PRODUCTION: without it the app refuses to sign or verify admin
# sessions rather than falling back to a key that is public in this repo.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Signs the cookie for the legacy Express server only (npm run legacy-server).
SESSION_SECRET=change-me

# Seeded on first run, only when no admin account exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Local only; Vercel sets its own port.
PORT=3000
